{
  "name": "brew-buddy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Brew Buddy — persönliches Dial-in-Werkzeug für Espresso, V60, AeroPress und French Press",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "oxlint",
    "kontrast": "node scripts/kontrast.mjs",
    "pruefen": "npm run lint && npm run kontrast && npm run build && npm test",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "deploy:direct": "bash scripts/deploy-direct.sh",
    "deploy:restore": "bash scripts/deploy-restore.sh",
    "icons": "node scripts/make-icons.mjs",
    "worldmap": "node scripts/make-worldmap.mjs"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "oxlint": "^1.82.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  }
}

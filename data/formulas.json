      "openedPenalty": "score * max(0.6, 1 - 0.004 * daysSinceOpened)",
      "_batchbrewNote": "Fenstermitte wie beim V60 — derselbe Papierfilter, dieselbe Entgasung. Sigma liegt zwischen V60 und Immersion: Das tiefe Bett und die feste Agitation mitteln Unterschiede aus, das Fenster ist also breiter, aber nicht so breit wie bei voller Immersion (kb/10c §1)."
    },
    {
      "id": "F-32",
      "name": "ageGrindDrift",
      "label": "Mahlgraddrift durch Alterung",
      "expr": "-0.08 * (daysNow - daysRef)",
      "inputs": [
        "daysNow",
        "daysRef"
      ],
      "unit": "Schritte",
      "confidence": "low",
      "scope": [
        "espresso"
      ],
      "note": "Negativ = feiner. Ca. 1 Schritt je 12 Tage."
    },
    {
      "id": "F-33",
      "name": "caffeineEstimate",
      "label": "Koffein-Schätzung",
      "expr": "caffeineFraction * doseG * 1000 * efficiency",
      "inputs": [
        "caffeineFraction",
        "doseG",
        "efficiency"
      ],
      "unit": "mg",
      "confidence": "low",
      "outputAsRange": true,
      "caffeineFraction": {
        "arabica": 0.012,
        "robusta": 0.022
      },
      "efficiency": {

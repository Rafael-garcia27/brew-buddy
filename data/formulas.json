{
  "$schema": "./schema/formulas.schema.json",
  "version": "1.0.0",
  "source": "kb/02-formelsammlung.md",
  "constants": {
    "C_WATER_J_PER_G_K": 4.18,
    "C_ICE_J_PER_G_K": 2.09,
    "C_MILK_J_PER_G_K": 3.9,
    "C_BEVERAGE_J_PER_G_K": 4.1,
    "L_FUSION_J_PER_G": 334,
    "H_VAPORIZATION_J_PER_G": 2257,
    "RHO_WATER_G_PER_ML": 0.998,
    "MAX_SOLUBLE_PCT": 30
  },
  "defaults": {
    "lrr": {
      "v60_paper": 2.0,
      "v60_metal": 1.8,
      "aeropress_standard": 1.5,
      "aeropress_inverted": 1.6,
      "frenchpress": 2.2,
      "batchbrew": 2.0
    },
    "iceTempC": -18,
    "espressoLandingTempC": 80,
    "steamWetnessFactor": 1.15
  },
  "formulas": [
    {
      "id": "F-01",
      "name": "ratioFilter",
      "label": "Brew Ratio (Filter)",
      "expr": "waterG / doseG",
      "inputs": [
        "waterG",
        "doseG"
      ],
      "unit": "-",
      "confidence": "high"
    },
    {
      "id": "F-02",
      "name": "ratioEspresso",
      "label": "Brew Ratio (Espresso)",
      "expr": "yieldG / doseG",
      "inputs": [
        "yieldG",
        "doseG"
      ],
      "unit": "-",
      "confidence": "high",
      "note": "Nenner ist die Masse IM GLAS, nicht das Brühwasser."
    },
    {
      "id": "F-03",
      "name": "targetYield",
      "label": "Zielausbringung",
      "expr": "doseG * ratio",
      "inputs": [
        "doseG",
        "ratio"
      ],
      "unit": "g",
      "confidence": "high"
    },
    {
      "id": "F-04",
      "name": "doseForYield",
      "label": "Dosis aus Zielausbringung",
      "expr": "yieldG / ratio",
      "inputs": [
        "yieldG",
        "ratio"
      ],
      "unit": "g",
      "confidence": "high"
    },
    {
      "id": "F-05",
      "name": "beverageMass",
      "label": "Getränkemasse (Filter)",
      "expr": "waterG - lrr * doseG",
      "inputs": [
        "waterG",
        "doseG",
        "lrr"
      ],
      "unit": "g",
      "confidence": "medium",
      "note": "Ohne diesen Term wird EY um 10-15% relativ zu niedrig berechnet."
    },
    {
      "id": "F-06",
      "name": "extractionYield",
      "label": "Extraktionsausbeute",
      "expr": "(tdsPct * beverageG) / doseG",
      "inputs": [
        "tdsPct",
        "beverageG",
        "doseG"
      ],
      "unit": "%",
      "confidence": "high",
      "core": true
    },
    {
      "id": "F-07",
      "name": "solidsMass",
      "label": "Extrahierte Feststoffmasse",
      "expr": "(ey / 100) * doseG",
      "inputs": [
        "ey",
        "doseG"
      ],
      "unit": "g",
      "confidence": "high"
    },
    {
      "id": "F-08a",
      "name": "expectedTdsEspresso",
      "label": "Erwartetes TDS (Espresso)",
      "expr": "ey / ratio",
      "inputs": [
        "ey",
        "ratio"
      ],
      "unit": "%",
      "confidence": "high"
    },
    {
      "id": "F-08b",
      "name": "expectedTdsFilter",
      "label": "Erwartetes TDS (Filter)",
      "expr": "ey / (ratio - lrr)",
      "inputs": [
        "ey",
        "ratio",
        "lrr"
      ],
      "unit": "%",
      "confidence": "high",
      "note": "Erlaubt Stärkevorhersage ohne Refraktometer."
    },
    {
      "id": "F-09",
      "name": "ratioForTargetTds",
      "label": "Ratio für Ziel-TDS (Filter)",
      "expr": "ey / tdsTarget + lrr",
      "inputs": [
        "ey",
        "tdsTarget",
        "lrr"
      ],
      "unit": "-",
      "confidence": "high"
    },
    {
      "id": "F-10",
      "name": "waterForBeverage",
      "label": "Wasser für Ziel-Getränkemasse",
      "expr": "targetBeverageG + lrr * doseG",
      "inputs": [
        "targetBeverageG",
        "lrr",
        "doseG"
      ],
      "unit": "g",
      "confidence": "high"
    },
    {
      "id": "F-11",
      "name": "blendTds",
      "label": "Mischungs-TDS",
      "expr": "sum(m_i * tds_i) / sum(m_i)",
      "inputs": [
        "components"
      ],
      "unit": "%",
      "confidence": "high",
      "isReduction": true
    },
    {
      "id": "F-12",
      "name": "americanoTds",
      "label": "Americano End-TDS",
      "expr": "(tdsEsp * espG) / (espG + waterG)",
      "inputs": [
        "tdsEsp",
        "espG",
        "waterG"
      ],
      "unit": "%",
      "confidence": "high"
    },
    {
      "id": "F-13",
      "name": "waterForTargetTds",
      "label": "Wassermenge für Ziel-TDS",
      "expr": "espG * (tdsEsp / tdsTarget - 1)",
      "inputs": [
        "espG",
        "tdsEsp",
        "tdsTarget"
      ],
      "unit": "g",
      "confidence": "high"
    },
    {
      "id": "F-14",
      "name": "bypassInvariant",
      "label": "Bypass-Invariante",
      "expr": "(tdsConc * concG) / doseG",
      "inputs": [
        "tdsConc",
        "concG",
        "doseG"
      ],
      "unit": "%",
      "confidence": "high",
      "note": "EY bleibt bei Verdünnung KONSTANT. Bypass ist nie eine Antwort auf Bitterkeit."
    },
    {
      "id": "F-15",
      "name": "bypassWater",
      "label": "Bypass-Wasser für Zielstärke",
      "expr": "concG * (tdsConc / tdsTarget - 1)",
      "inputs": [
        "concG",
        "tdsConc",
        "tdsTarget"
      ],
      "unit": "g",
      "confidence": "high"
    },
    {
      "id": "F-16",
      "name": "mixTemperature",
      "label": "Mischtemperatur",
      "expr": "sum(m_i * c_i * T_i) / sum(m_i * c_i)",
      "inputs": [
        "components"
      ],
      "unit": "°C",
      "confidence": "high",
      "isReduction": true
    },
    {
      "id": "F-17",
      "name": "iceForTargetTemp",
      "label": "Eismenge für Zieltemperatur",
      "expr": "(hotG * 4.10 * (tHot - tFinal)) / (2.09 * abs(tIce) + 334 + 4.18 * tFinal)",
      "inputs": [
        "hotG",
        "tHot",
        "tFinal",
        "tIce"
      ],
      "unit": "g",
      "confidence": "high",
      "note": "Berechnet die Menge, die exakt vollständig schmilzt. Für Restwürfel Faktor 1,3-1,5."
    },
    {
      "id": "F-18",
      "name": "meltDilution",
      "label": "Schmelzwasser-Verdünnung",
      "expr": "tdsInit * (initG / (initG + meltG))",
      "inputs": [
        "tdsInit",
        "initG",
        "meltG"
      ],
      "unit": "%",
      "confidence": "high"
    },
    {
      "id": "F-19",
      "name": "steamCondensate",
      "label": "Milchverdünnung durch Dampf",
      "expr": "(3.90 * (tFinal - tStart)) / (2257 + 4.18 * (100 - tFinal))",
      "inputs": [
        "tStart",
        "tFinal"
      ],
      "unit": "ratio",
      "confidence": "high",
      "note": "Ergebnis mit milkStartG multiplizieren. Real 1,1-1,3x wegen feuchtem Dampf."
    },
    {
      "id": "F-20",
      "name": "darcyFlow",
      "label": "Darcy-Gesetz",
      "expr": "(k * A * dP) / (mu * L)",
      "inputs": [
        "k",
        "A",
        "dP",
        "mu",
        "L"
      ],
      "unit": "m³/s",
      "confidence": "high",
      "qualitativeOnly": true
    },
    {
      "id": "F-22",
      "name": "grindScaleFactor",
      "label": "Mahlgradkorrektur aus Zeitabweichung",
      "expr": "sqrt(actualTimeS / targetTimeS)",
      "inputs": [
        "actualTimeS",
        "targetTimeS"
      ],
      "unit": "-",
      "confidence": "medium",
      "core": true,
      "note": ">1 = gröber, <1 = feiner. GESPERRT bei flowState uneven/spritzing.",
      "guard": "flowState !== 'uneven' && flowState !== 'spritzing'"
    },
    {
      "id": "F-23",
      "name": "grindSteps",
      "label": "Mahlgradschritte",
      "expr": "round((currentMicron * (factor - 1)) / micronPerStep)",
      "inputs": [
        "currentMicron",
        "factor",
        "micronPerStep"
      ],
      "unit": "Schritte",
      "confidence": "low"
    },
    {
      "id": "F-22r",
      "name": "expectedTimeAfterGrindChange",
      "label": "Erwartete Zeit nach Mahlgradänderung",
      "expr": "actualTimeS * pow(currentMicron / newMicron, 2)",
      "inputs": [
        "actualTimeS",
        "currentMicron",
        "newMicron"
      ],
      "unit": "s",
      "confidence": "medium",
      "note": "Umkehrung von F-22. Liefert die überprüfbare Erwartung für die Diagnoseausgabe."
    },
    {
      "id": "F-24",
      "name": "flowRate",
      "label": "Flussrate",
      "expr": "yieldG / timeS",
      "inputs": [
        "yieldG",
        "timeS"
      ],
      "unit": "g/s",
      "confidence": "high"
    },
    {
      "id": "F-25a",
      "name": "basketArea",
      "label": "Korbquerschnitt",
      "expr": "PI * pow(basketDiameterMm / 20, 2)",
      "inputs": [
        "basketDiameterMm"
      ],
      "unit": "cm²",
      "confidence": "high"
    },
    {
      "id": "F-25b",
      "name": "doseDensity",
      "label": "Dosisdichte",
      "expr": "doseG / basketAreaCm2",
      "inputs": [
        "doseG",
        "basketAreaCm2"
      ],
      "unit": "g/cm²",
      "confidence": "medium",
      "targetRange": [
        0.62,
        0.76
      ],
      "note": "Macht Rezepte zwischen Korbgrößen übertragbar."
    },
    {
      "id": "F-26",
      "name": "puckHeight",
      "label": "Trockene Puckhöhe",
      "expr": "doseG / (bulkDensity * basketAreaCm2)",
      "inputs": [
        "doseG",
        "bulkDensity",
        "basketAreaCm2"
      ],
      "unit": "cm",
      "confidence": "low"
    },
    {
      "id": "F-27",
      "name": "specificSurfaceArea",
      "label": "Spezifische Oberfläche",
      "expr": "6 / (rho * d)",
      "inputs": [
        "rho",
        "d"
      ],
      "unit": "m²/kg",
      "confidence": "high"
    },
    {
      "id": "F-29",
      "name": "grinderMicron",
      "label": "Mühlenskala zu Mikrometer",
      "expr": "zeroPointOffsetMicron + setting * micronPerStep",
      "inputs": [
        "zeroPointOffsetMicron",
        "setting",
        "micronPerStep"
      ],
      "unit": "µm",
      "confidence": "low"
    },
    {
      "id": "F-30",
      "name": "co2Remaining",
      "label": "CO₂-Restgehalt",
      "expr": "m0 * exp(-days / tau)",
      "inputs": [
        "m0",
        "days",
        "tau"
      ],
      "unit": "mg/g",
      "confidence": "medium",
      "tau": {
        "light": 20,
        "medium-light": 17,
        "medium": 14,
        "medium-dark": 11,
        "dark": 9
      }
    },
    {
      "id": "F-31",
      "name": "freshnessScore",
      "label": "Frische-Score",
      "expr": "100 * exp(-pow(days - tPeak, 2) / (2 * pow(sigma, 2)))",
      "inputs": [
        "days",
        "tPeak",
        "sigma"
      ],
      "unit": "0-100",
      "confidence": "low",

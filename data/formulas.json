        ],
        "coldbrew": [
          0.7,
          0.85
        ]
      },
      "note": "Unpräziseste Formel der Sammlung. Immer als Spanne ausgeben."
    },
    {
      "id": "F-34",
      "name": "costPerCup",
      "label": "Kosten pro Tasse",
      "expr": "(pricePerKg / 1000) * doseG",
      "inputs": [
        "pricePerKg",
        "doseG"
      ],
      "unit": "EUR",
      "confidence": "high"
    },
    {
      "id": "F-40",
      "name": "drinkIntensity",
      "label": "Kaffeeintensität eines Getränks",
      "expr": "(tdsBrew * brewG) / totalG",
      "inputs": [
        "tdsBrew",
        "brewG",
        "totalG"
      ],
      "unit": "%",
      "confidence": "high",
      "source": "kb/12-getraenke.md §1",
      "note": "Vergleichsmaß über alle Getränkekategorien hinweg."
    },
    {
      "id": "F-41",
      "name": "milkToPour",
      "label": "Einzufüllende Milchmenge",
      "expr": "targetMilkFinalG / ((1 + overrun) * (1 + steamCondensate))",
      "inputs": [
        "targetMilkFinalG",
        "overrun",
        "steamCondensate"
      ],
      "unit": "g",
      "confidence": "medium",
      "source": "kb/11-milch.md §7"
    }
  ],

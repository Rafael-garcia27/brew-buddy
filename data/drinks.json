  "validation": {
    "intensityHighMilk": { "when": "intensityPct > 4 && category === 'milk'", "message": "Sehr kräftig — bitte prüfen" },
    "intensityLow":      { "when": "intensityPct < 1", "message": "Sehr dünn — Ratio prüfen" },
    "tooFewShots":       { "when": "glassMl > 400 && shots === 1", "message": "Ein Shot ist für dieses Volumen zu wenig" },
    "milkDominates":     { "when": "milkG / espressoG > 10", "message": "Kaffee wird kaum wahrnehmbar sein" },
    "iceTooLittle":      { "when": "icePct < 0.25", "message": "Zu wenig Eis — Getränk bleibt lauwarm" },
    "iceTooMuch":        { "when": "icePct > 0.55", "message": "Zu viel Eis — Getränk wird wässrig" },
    "coldBrewLightRoast":{ "when": "icedMode === 'cold-brew' && roastLevel === 'light'",
                           "message": "Cold Brew zerstört die Säurestruktur dieser Bohne — Flash Chill empfohlen" }
  }

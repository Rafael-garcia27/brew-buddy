{
  "version": "1.0.0",
  "source": "kb/14-diagnostik.md",
  "engine": {
    "stages": [
      {
        "id": 0,
        "name": "gates",
        "description": "Ist das Ergebnis interpretierbar?",
        "blocksLater": true
      },
      {
        "id": 0.5,
        "name": "runCheck",
        "description": "Laufkontrolle — Zeit, Fluss und Beobachtungen, noch ohne Geschmack",
        "blocksLater": false,
        "_note": "Läuft vor der Verkostung. Grundlage: kb/15 §3.1 trennt Phase C (Mahlgrad über die Zeit) von Phase D (Geschmack feinjustieren)."
      },
      {
        "id": 1,
        "name": "objective",
        "description": "Brew Control Chart, nur mit TDS-Messung"
      },
      {
        "id": 2,
        "name": "sensory",
        "description": "Fehlerachse + Beobachtungen"
      }
    ],
    "correctionCascade": [
      "grindSetting",
      "ratio",
      "waterTempC",
      "technique",
      "pressureBar",
      "doseG"
    ],
    "maxCorrectionsPerIteration": 1,
    "exception": "Stufe 1 mit TDS-Messung darf grindSetting UND ratio gleichzeitig korrigieren (orthogonale Achsen).",
    "conflictResolution": [
      "Stufe 0 blockiert immer alles Weitere",
      "niedrigste priority gewinnt",
      "bei Gleichstand: höhere confidence",
      "bei Gleichstand: höhere Sensitivität laut variables.json"
    ]
  },
  "rules": [
    {
      "id": "D-01",
      "stage": 0,
      "priority": 1,
      "scope": [
        "espresso"
      ],
      "when": "flowState in ['uneven','spritzing'] || puckState in ['crater','sideChannel']",
      "cause": "Ungleichmäßige Durchströmung des Pucks (Channeling)",
      "action": {
        "variable": "technique",
        "direction": "technique"
      },
      "techniqueSteps": [
        "WDT (8-12 Bewegungen)",
        "kalibrierter Tamper / eben tampen",
        "nach dem Tampen nicht klopfen",
        "Dose prüfen (Headspace)",
        "Korb auf Verstopfung prüfen"
      ],
      "explanation": "Ein Teil des Wassers hat den Kaffee umgangen. Die gemessene Zeit sagt deshalb nichts über deinen Mahlgrad aus — sie würde dich in die falsche Richtung schicken.",
      "blocks": [
        "ALL_GRIND",
        "ALL_RATIO",
        "F-22"
      ],
      "confidence": "high"
    },
    {
      "id": "D-02",
      "stage": 0,
      "priority": 1,
      "scope": [
        "espresso",
        "v60",
        "aeropress",
        "frenchpress"
      ],
      "when": "defects includes 'sour' && (defects includes 'bitter' || defects includes 'astringent')",
      "cause": "Ungleichmäßige Extraktion — nicht zu viel und nicht zu wenig, sondern beides gleichzeitig",
      "action": {
        "variable": "technique",
        "direction": "technique"
      },
      "techniqueByMethod": {
        "espresso": [
          "WDT",
          "ebener Tamp",
          "Präinfusion verlängern"
        ],
        "v60": [
          "nach dem Bloom swirlen",
          "nicht aufs Papier gießen",
          "Rao Spin"
        ],
        "aeropress": [
          "Mahlwerk prüfen (Alignment/Schärfe)",
          "Röstung verdächtigen — Channeling ist hier unmöglich"
        ],
        "frenchpress": [
          "zügig aufgießen, alles Mehl benetzen",
          "Kruste bei 4:00 brechen und umrühren",
          "gleichmäßiger mahlen"
        ]
      },
      "explanation": "Sauer und bitter gleichzeitig ist kein Widerspruch, sondern die Signatur ungleichmäßiger Extraktion. Ein Teil des Kaffees ist überextrahiert, ein anderer unterextrahiert. Mahlgrad hilft hier nicht.",
      "blocks": [
        "ALL_GRIND",
        "ALL_RATIO"
      ],
      "confidence": "high"
    },
    {
      "id": "D-03",
      "stage": 0,
      "priority": 2,
      "scope": [
        "espresso",
        "v60",
        "aeropress",
        "frenchpress"
      ],
      "when": "daysOffRoast < restWindow.min",
      "cause": "Zu viel CO₂ — die Bohne ist noch nicht ausgegast",
      "action": {
        "variable": "none",
        "direction": "none"
      },
      "explanation": "CO₂ verdrängt das Wasser und macht Ergebnisse instabil. Warte, bis das Ruhefenster erreicht ist.",
      "blocks": [
        "ALL"
      ],
      "confidence": "high"
    },
    {
      "id": "D-04",
      "stage": 0,
      "priority": 2,
      "scope": [
        "espresso",
        "v60",
        "aeropress",
        "frenchpress"
      ],
      "when": "daysOffRoast > 60",
      "cause": "Aromaverlust und Lipidoxidation",
      "action": {
        "variable": "none",
        "direction": "none"
      },
      "explanation": "Diese Bohne ist über 60 Tage alt. Aromaverlust ist durch keine Brühkorrektur reparierbar.",
      "blocks": [
        "ALL"
      ],
      "confidence": "high"
    },
    {
      "id": "D-05",
      "stage": 0,
      "priority": 1,
      "scope": [
        "espresso",
        "v60",
        "aeropress",
        "frenchpress"
      ],
      "when": "ey > 26 || ey < 12 || tdsPct > 15",
      "cause": "Unplausible Messung",
      "action": {
        "variable": "none",
        "direction": "none"
      },
      "checklist": [
        "Probe gefiltert?",
        "Auf 20-25 °C abgekühlt?",
        "Espresso vor der Messung durchgerührt?",
        "Prisma sauber?",
        "Dreifachmessung, Median?"
      ],
      "explanation": "Dieser Wert liegt außerhalb des physikalisch Plausiblen. Bitte die Messung wiederholen.",
      "blocks": [
        "ALL"
      ],
      "confidence": "high"
    },
    {
      "id": "D-06",
      "stage": 0,
      "priority": 3,
      "scope": [
        "espresso",
        "v60",
        "aeropress",
        "frenchpress"
      ],
      "when": "ey >= 18 && ey <= 22 && rating <= 2 && defects includes 'flat' && !(defects includes 'sour') && !(defects includes 'bitter')",
      "cause": "Vermutlich zu hohe Karbonathärte im Wasser",
      "action": {
        "variable": "water",
        "direction": "none"
      },
      "explanation": "Deine Extraktion ist objektiv korrekt, der Kaffee schmeckt trotzdem flach. Das ist die typische Signatur zu hoher Karbonathärte — sie puffert die Kaffeesäuren weg, ohne die Extraktion zu verändern. Miss deine KH; Zielbereich 20-60 mg/L CaCO₃.",
      "reference": "kb/06-wasser.md",
      "blocks": [
        "ALL_BREW_PARAMS"
      ],
      "confidence": "medium"
    },
    {
      "id": "D-07",
      "stage": 0,
      "priority": 3,
      "scope": [
        "espresso",
        "v60",
        "aeropress",
        "frenchpress"
      ],
      "when": "last3CorrectionsSameDirection('finer') && !ratingImproved() && defects includes 'sour' && defects includes 'bitter'",
      "cause": "Unterentwickelte Röstung",
      "action": {
        "variable": "bean",
        "direction": "none"
      },
      "explanation": "Du bist dreimal feiner gegangen. Die Säure ist geblieben und Bitterkeit ist dazugekommen — das ist das Muster einer unterentwickelten Röstung, nicht einer Unterextraktion. Diese Bohne wird mit keiner Einstellung ausgewogen.",
      "reference": "kb/05-roestung-frische.md §1.2",
      "blocks": [
        "ALL"
      ],
      "confidence": "medium"
    },
    {
      "id": "D-08",
      "stage": 0,
      "priority": 4,
      "scope": [
        "espresso"
      ],
      "when": "stdDev(last5BrewTimes) > 4 && sameRecipe(last5)",
      "cause": "Prozessstreuung, kein Rezeptfehler",
      "action": {
        "variable": "technique",
        "direction": "technique"
      },
      "techniqueSteps": [
        "auf 0,1 g wiegen",
        "RDT anwenden",
        "Single Dosing mit Purge",
        "kalibrierter Tamper"
      ],
      "explanation": "Deine Shotzeiten schwanken um mehr als 4 s bei identischem Rezept. Bevor du das Rezept änderst, mach es erst wiederholbar.",
      "blocks": [
        "ALL_GRIND"
      ],
      "confidence": "medium"
    },

  "derivationRules": [
    {
      "when": "altitudeMasl > 1800",
      "apply": {
        "grindSteps": -1.5,
        "waterTempC": 1.5
      },
      "reason": "Dichtere Bohne, schwerer zu extrahieren"
    },
    {
      "when": "densityGL > 400",
      "apply": {
        "grindSteps": -1
      },
      "reason": "Härtere Bohne"
    },
    {
      "when": "process === 'natural'",
      "apply": {
        "grindSteps": 1,
        "ratio": -0.1
      },
      "reason": "Höhere Löslichkeit"
    },
    {
      "when": "process in ['anaerobic','carbonic-maceration']",
      "apply": {
        "grindSteps": 1,
        "contactTimePct": -10
      },
      "reason": "Atypisch hohe Löslichkeit"
    },
    {
      "when": "process === 'wet-hulled'",
      "apply": {
        "waterTempC": -2
      },
      "reason": "Sehr niedrige Säure, fehlerverzeihend"
    },
    {
      "when": "variety in ['sl28','sl34']",
      "apply": {},
      "userWarning": "Hohe Säureerwartung"
    },
    {
      "when": "variety === 'geisha'",
      "apply": {
        "ratio": 0.5,
        "doseG": -1
      },
      "preferMethod": "v60"
    },
    {
      "when": "origin === 'brazil'",
      "preferMethod": "espresso",
      "milkFriendly": true
    },
